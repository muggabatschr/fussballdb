# Kopieren nach .env und ausfüllen. Leere Werte = Standard aus src/fussballdb/config.py.

# Datenbank (Standard: postgresql+psycopg://fussball:fussball@localhost:5442/fussballdb, siehe docker-compose.yml)
DATABASE_URL=

# Chat lokal (Standard): "local" = OpenAI-kompatibler Server, z. B. LM Studio/Bionic oder Ollama
LLM_PROVIDER=
# Adresse des Servers (Standard: http://localhost:1234/v1, Ollama: http://localhost:11434/v1)
LOCAL_LLM_URL=
# Modellname, leer = erstes geladenes Modell
LOCAL_LLM_MODEL=
# "none" = ohne Nachdenken vor der Antwort (schneller), leer = Standard des Modells
LOCAL_LLM_REASONING=

# Optional Claude API statt lokalem Modell: LLM_PROVIDER=anthropic und `uv sync --extra claude`
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Punkteregel des Tippspiels: Sieg Tendenz, Sieg Tordifferenz, exakt, Remis Tendenz
# (Standard: 2,3,4,3; Kicktipp-Standard: 2,3,4,2)
TIPP_PUNKTE=

# Web-App im Docker-Container (docker compose --profile app): Modell und Thinking für den Chat
LLM_MODEL=
LLM_REASONING=
