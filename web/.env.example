# Kopieren nach .env.local und ausfüllen. Leere Werte = Standard.

# Python-API (uv run fussballdb serve), Standard: http://127.0.0.1:8000
FUSSBALL_API_URL=
# Lokales Sprachmodell, OpenAI-kompatibel, Standard: http://127.0.0.1:1234/v1 (Ollama: 11434)
LLM_BASE_URL=
# Modellname, leer = erstes geladenes Modell
LLM_MODEL=
# "none" = ohne Nachdenken vor der Antwort (schneller), leer = Standard des Modells
LLM_REASONING=
